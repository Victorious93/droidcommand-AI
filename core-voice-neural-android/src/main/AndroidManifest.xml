<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wake word keeps the microphone open, so it runs as a visible foreground service of type microphone
         (Android 14+ requires the type-specific permission). Opt-in and off by default; see WakeWordService. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="ai.droidcommand.voice.neural.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
