.gradle/
/build/
/*/build/
tools/*/build/
.kotlin/
*.iml
.idea/
local.properties

# Locally built APKs handed to the user for sideloading; never commit binaries.
/dist/

# llama.cpp is fetched at a pinned commit by core-llm-local-android/scripts/fetch-llama-cpp.sh
/core-llm-local-android/third_party/
/core-llm-local-android/.cxx/

# Prebuilt sherpa-onnx AAR is fetched + SHA-256-verified by core-voice-neural-android/scripts/fetch-sherpa-onnx.sh
/core-voice-neural-android/libs/

# Official Shizuku APK is fetched + SHA-256-verified by app/scripts/fetch-shizuku-payload.sh
# Runtime ADB pairing keys must never be committed.
/app/build/shizuku-payload/
**/adbkey
**/adbkey.pub
