root = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = off

# ROADMAP-119: ktlint's "official" ruleset is a wrapping/line-length style
# opinion, not a correctness check. This codebase's existing style favors
# long, thorough KDoc/doc-comment prose and single-line multi-argument
# calls where they still read clearly — deliberately, not accidentally.
# Reformatting the entire repository to ktlint's default wrapping opinion
# would produce a huge, purely-cosmetic diff for what should be a small
# gap (no Kotlin lint configured at all). Disabling only the wrapping/
# line-length/blank-line rules below keeps the substantive checks (unused
# imports, no wildcard imports, trailing whitespace, final newline,
# consistent indentation, standard bracing) enforced without fighting an
# already-deliberate style.
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_parameter-list-wrapping = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_string-template-indent = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_blank-line-before-declaration = disabled
# Dagger/Hilt `class X @Inject constructor(...)` is the idiom everywhere in :app; the rule would re-indent whole class bodies.
ktlint_standard_annotation = disabled

# Jetpack Compose names @Composable functions in PascalCase by convention (Kotlin API guidelines allow it for
# functions that act like constructors); ktlint's function-naming rule must not flag them.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Vendored Shizuku Adb client (Apache-2.0). Package name is load-bearing for JNI.
[app/src/main/kotlin/moe/shizuku/manager/adb/**.kt]
ktlint_standard = disabled
