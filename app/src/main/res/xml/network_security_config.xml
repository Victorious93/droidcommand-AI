<?xml version="1.0" encoding="utf-8"?>
<!-- docs/SECURITY.md, "Networking": HTTPS only, trust the system CA store only. targetSdk 36 already defaults to this;
     stating it here keeps it true if a dependency's manifest ever asks for cleartext, and makes it reviewable.
     A feature that must reach a loopback or LAN HTTP service (e.g. a local server) has to add a narrow
     <domain-config> for that one host deliberately; do not loosen base-config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
