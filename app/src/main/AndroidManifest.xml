<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Every LLM provider call and (future) web-search lookup goes over HTTPS
         via core-remote's JdkHttpTransport; nothing else in this Phase 0 shell
         needs a permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 4 — Companion APK signature permissions.
         protectionLevel="signature" means only apps signed with the same key as
         DroidCommand AI (i.e. only DCA itself) can hold and use these permissions.
         The companion APKs declare `android:permission="..."` on their bound services,
         so the OS blocks any third-party binder attempt at the kernel level — no
         in-process policy check needed. -->
    <permission
        android:name="ai.droidcommand.permission.BIND_HACKERAI"
        android:protectionLevel="signature" />
    <permission
        android:name="ai.droidcommand.permission.BIND_PENTESTSWARM"
        android:protectionLevel="signature" />

    <application
        android:name=".DroidCommandApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="DroidCommand AI"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
